# Apple reads this file to offer Save Password in the app (webcredentials).
/.well-known/apple-app-site-association
  Content-Type: application/json

# X-Frame-Options and frame-ancestors: no other site may show these pages
# inside a frame. That is all the Content-Security-Policy does here; it does
# not limit what the pages themselves load.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
