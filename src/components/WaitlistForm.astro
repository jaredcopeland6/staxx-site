---
// Email box + "Join the waitlist". Posts to the join-waitlist Edge Function in
// storee-app, after a Cloudflare Turnstile check that people are not bots.
// Turnstile stays invisible unless Cloudflare is unsure, then shows a box.
//
// The script below does the sending. If it can't run (JavaScript off), the
// form on its own goes nowhere: method="post" keeps the email out of the page
// address, and the javascript: action is one a browser without JavaScript
// ignores, so nothing is sent and the page stays put.
import site from '../data/site.json';

interface Props {
  id: string;
  /** Where on the page the form sits, stored with the email. */
  source: 'hero' | 'closing' | 'book';
}
const { id, source } = Astro.props;
---
<div class="waitlist-root" data-waitlist data-endpoint={site.waitlist.endpoint} data-sitekey={site.waitlist.turnstileSiteKey} data-source={source}>
  <form id={id} class="waitlist" method="post" action="javascript:void(0)" novalidate aria-label="Join the waitlist">
    <label class="visually-hidden" for={`${id}-email`}>Email address</label>
    <input id={`${id}-email`} name="email" type="email" inputmode="email" autocomplete="email" placeholder="you@email.com" required maxlength="254">
    <button type="submit">Join the waitlist</button>
  </form>
  <div class="turnstile-slot"></div>
  <p class="waitlist-status" role="status" aria-live="polite"></p>
  <noscript><p class="waitlist-status">Joining the waitlist needs JavaScript turned on in your browser.</p></noscript>
</div>

<script>
  type Turnstile = {
    render: (el: Element, opts: Record<string, unknown>) => string;
    execute: (widgetId: string) => void;
    reset: (widgetId: string) => void;
  };
  declare global {
    interface Window { turnstile?: Turnstile; onStaxxTurnstile?: () => void }
  }

  const EMAIL = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
  const roots = [...document.querySelectorAll<HTMLElement>('[data-waitlist]')];

  // Cloudflare's bot check is fetched from their servers. If the browser
  // can't get it (offline, or a content blocker), the next press of the
  // button tries again, instead of answering "Still loading" forever.
  let turnstileBlocked = false;
  function loadTurnstile() {
    turnstileBlocked = false;
    const s = document.createElement('script');
    s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    s.async = true;
    s.defer = true;
    s.onerror = () => {
      turnstileBlocked = true;
      s.remove();
    };
    document.head.append(s);
  }

  function setup(root: HTMLElement) {
    const form = root.querySelector('form')!;
    const input = form.querySelector('input')!;
    const button = form.querySelector('button')!;
    const status = root.querySelector<HTMLElement>('.waitlist-status')!;
    const slot = root.querySelector('.turnstile-slot')!;
    let widgetId: string | null = null;

    const say = (text: string, tone: 'info' | 'error' = 'info') => {
      status.textContent = text;
      status.dataset.tone = tone;
    };
    const busy = (on: boolean) => {
      button.disabled = on;
      button.textContent = on ? 'Joining…' : 'Join the waitlist';
    };

    // The check failed or ran out of time. Free the button and reset the
    // check, so pressing the button again starts a fresh one.
    const checkFailed = () => {
      busy(false);
      say('We couldn’t check you’re not a bot. Please try again.', 'error');
      try {
        if (widgetId) window.turnstile?.reset(widgetId);
      } catch {
        widgetId = null; // the box is gone; the next try draws a new one
      }
    };

    async function send(token: string) {
      try {
        const res = await fetch(root.dataset.endpoint!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: input.value.trim(), token, source: root.dataset.source }),
        });
        if (!res.ok) throw new Error(String(res.status));
        const done = document.createElement('p');
        done.className = 'waitlist-done';
        done.textContent = "You're on the list. We'll email you when Staxx arrives.";
        root.replaceChildren(done);
      } catch {
        busy(false);
        say('That didn’t go through. Please try again in a moment.', 'error');
        if (widgetId) window.turnstile?.reset(widgetId);
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!EMAIL.test(input.value.trim())) {
        say('Please enter a full email address, like you@email.com.', 'error');
        input.focus();
        return;
      }
      if (!window.turnstile) {
        if (turnstileBlocked) {
          loadTurnstile();
          say('The check that keeps bots out didn’t load. Check your connection or pause any content blocker, then try again.', 'error');
        } else {
          say('Still loading. Please try again in a second.', 'error');
        }
        return;
      }
      say('');
      busy(true);
      try {
        widgetId ??= window.turnstile.render(slot, {
          sitekey: root.dataset.sitekey,
          execution: 'execute',
          appearance: 'interaction-only',
          // One try per press: a failure comes back here instead of being
          // retried behind an error message.
          retry: 'never',
          callback: (token: string) => send(token),
          'error-callback': () => {
            checkFailed();
            return true; // handled
          },
          'timeout-callback': checkFailed,
        });
        window.turnstile.execute(widgetId);
      } catch {
        checkFailed();
      }
    });
  }

  if (roots.length) {
    roots.forEach(setup);
    loadTurnstile();
  }
</script>
