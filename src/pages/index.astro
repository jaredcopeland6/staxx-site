---
// The homepage. All of its words live in src/data/home.json, so they can be
// edited in Pages CMS without touching this file.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhoneShot from '../components/PhoneShot.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import home from '../data/home.json';
import site from '../data/site.json';

const { seo, hero, steps, features, faq, closing } = home;

// Which app screenshot goes with which feature, matched by its id in home.json.
const screens = {
  'head-to-head': 'ranked',
  picks: 'vibe',
  discover: 'discover',
  friends: 'feed',
} as const;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: site.name,
    url: site.url,
    description: seo.description,
    operatingSystem: 'iOS',
    applicationCategory: 'LifestyleApplication',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---
<Base title={seo.title} description={seo.description} structuredData={structuredData}>
  <section class="on-ink">
    <Header ctaHref="#join" />
    <div class="wrap hero">
      <span class="badge-soon">{hero.badge}</span>
      <h1>{hero.titleStart} <em>{hero.titleEmphasis}</em></h1>
      <p class="hero-sub">{hero.subtitle}</p>
      <WaitlistForm id="join" source="hero" />
      <p class="availability">{hero.availability}</p>
      <div class="hero-phones">
        <PhoneShot shot="how-was-it" class="side left" />
        <PhoneShot shot="compare" class="center" eager />
        <PhoneShot shot="ranked" class="side right" />
      </div>
    </div>
  </section>

  <main>
    <section id="how" class="steps-band" aria-label="How it works">
      <div class="wrap steps">
        {steps.map((s, i) => (
          <div>
            <div class="step-num" aria-hidden="true">{i + 1}</div>
            <h2>{s.title}</h2>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </section>

    {features.map((f, i) => (
      <section id={f.id} class={i % 2 === 1 ? 'band' : undefined}>
        <div class={`wrap feature${i % 2 === 1 ? ' flip' : ''}`}>
          <div class="copy">
            <p class="eyebrow">{f.eyebrow}</p>
            <h2>{f.title}</h2>
            {f.paragraphs.map((p) => <p>{p}</p>)}
            {f.bullets.length > 0 && (
              <ul class="ticks">{f.bullets.map((b) => <li>{b}</li>)}</ul>
            )}
          </div>
          <div class="shot">
            <PhoneShot shot={screens[f.id as keyof typeof screens] ?? 'ranked'} />
          </div>
        </div>
      </section>
    ))}

    <section id="faq" class="faq">
      <div class="wrap">
        <h2>Questions</h2>
        {faq.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <section class="on-ink">
    <div class="wrap closing">
      <h2>{closing.titleStart} <em>{closing.titleEmphasis}</em> {closing.titleEnd}</h2>
      <p>{closing.text}</p>
      <WaitlistForm id="join-bottom" source="closing" />
      <p class="availability">{hero.availability}</p>
    </div>
    <Footer />
  </section>
</Base>
