---
// The link-preview picture (public/og.png) is a capture of this page: the
// homepage's dark top banner at exactly 1200 x 630, without the waitlist form.
// Hidden from search (noindex, left out of the sitemap). To remake og.png:
//   npm run dev, then
//   "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" --headless \
//     --window-size=1200,630 --hide-scrollbars --screenshot=public/og.png \
//     http://localhost:4321/og-card/
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import BrandMark from '../components/BrandMark.astro';
import PhoneShot from '../components/PhoneShot.astro';
import home from '../data/home.json';

const { hero } = home;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="robots" content="noindex">
  <title>Staxx link preview</title>
  <style is:global>
    html, body { margin: 0; width: 1200px; height: 630px; overflow: hidden; background: var(--ink); }
    .card {
      position: relative; width: 1200px; height: 630px; overflow: hidden;
      background: var(--ink); color: var(--ink-text);
      display: flex; flex-direction: column; align-items: center; text-align: center;
    }
    .brand { position: absolute; top: 34px; left: 44px; display: flex; align-items: center; gap: 12px; }
    .brand span { font-family: var(--serif); font-weight: 700; font-size: 34px; letter-spacing: -0.4px; }
    .card .badge-soon { margin-top: 44px; font-size: 18px; padding: 9px 18px; }
    .card h1 {
      margin: 22px 0 0; font-family: var(--serif); font-weight: 600; font-size: 104px;
      line-height: 0.98; letter-spacing: -2.5px;
    }
    .card h1 em { font-style: italic; font-weight: 400; color: var(--ink-accent-text); }
    .card .hero-sub { margin-top: 20px; font-size: 25px; max-width: 820px; }
    .phones { display: flex; justify-content: center; align-items: flex-start; gap: 0; margin-top: 34px; }
    .phones .phone { width: 230px; height: 476px; border-radius: 36px; padding: 8px; }
    .phones .screen { border-radius: 29px; }
    .phones .left { transform: rotate(-7deg) translate(40px, 30px); }
    .phones .right { transform: rotate(7deg) translate(-40px, 30px); }
    .phones .center { position: relative; z-index: 2; }
  </style>
</head>
<body>
  <div class="card">
    <div class="brand"><BrandMark size={44} /><span>Staxx</span></div>
    <span class="badge-soon">{hero.badge}</span>
    <h1>{hero.titleStart} <em>{hero.titleEmphasis}</em></h1>
    <p class="hero-sub">Compare books head to head. Get picks made for your taste.</p>
    <div class="phones">
      <PhoneShot shot="how-was-it" class="left" eager />
      <PhoneShot shot="compare" class="center" eager />
      <PhoneShot shot="ranked" class="right" eager />
    </div>
  </div>
</body>
</html>
